        <mxCell id="d1_v10" value="T1  Kebutuhan aplikasi terus berkembang.&lt;br&gt;T2  Malware, kehilangan data, ransomware.&lt;br&gt;T3  Gangguan listrik, panas dan kelembapan.&lt;br&gt;T4  Biaya penggantian/perubahan harga." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE4E0;strokeColor=#BDD1D8;fontColor=#183447;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;spacing=18;" vertex="1" parent="1">
