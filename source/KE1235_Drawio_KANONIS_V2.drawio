        <mxCell id="d1_v1" value="01   ANALISIS SWOT LAB RPL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#142D40;strokeColor=#142D40;fontColor=#FFFFFF;fontSize=27;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;fontStyle=1;" vertex="1" parent="1">
