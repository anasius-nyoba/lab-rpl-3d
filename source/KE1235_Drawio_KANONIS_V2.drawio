        </mxCell>
        <mxCell id="d1_v7" value="OPPORTUNITY / PELUANG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#187B85;strokeColor=#187B85;fontColor=#FFFFFF;fontSize=19;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="530" width="725" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="d1_v8" value="O1  Praktik coding, CBT, dan ekstrakurikuler.&lt;br&gt;O2  Praktik LAN dan tata kelola aset laboratorium.&lt;br&gt;O3  Kemitraan/sertifikasi jika disetujui sekolah." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBECFA;strokeColor=#BDD1D8;fontColor=#183447;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;spacing=18;" vertex="1" parent="1">
