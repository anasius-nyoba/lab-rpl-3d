        </mxCell>
        <mxCell id="d1_v2" value="Skenario usulan 2026; konteks UNBK 2019 dari tugas lama bersifat historis, bukan observasi laboratorium saat ini." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F5;strokeColor=#EAF2F5;fontColor=#677D8B;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;" vertex="1" parent="1">
