        <mxCell id="d1_v3" value="STRENGTH / KEKUATAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#187B85;strokeColor=#187B85;fontColor=#FFFFFF;fontSize=19;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="160" width="725" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="d1_v4" value="S1  Ruang usulan 120 m² mendukung pengelompokan 3 blok.&lt;br&gt;S2  Perangkat AIO seragam memudahkan penanganan.&lt;br&gt;S3  Struktur tugas teknisi, admin, kepala lab tersedia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8EDEA;strokeColor=#BDD1D8;fontColor=#183447;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="55" y="225" width="725" height="282" as="geometry"/>
        </mxCell>
        <mxCell id="d1_v5" value="WEAKNESS / KELEMAHAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#142D40;strokeColor=#142D40;fontColor=#FFFFFF;fontSize=19;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="725" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="d1_v6" value="W1  Uji IDE dan VM untuk spesifikasi AIO belum ada.&lt;br&gt;W2  Clearance kursi antarbaris sempit (HOLD-01).&lt;br&gt;W3  Data aset dan maintenance lama belum tervalidasi.&lt;br&gt;W4  Listrik dan HVAC belum memiliki desain terukur." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E3;strokeColor=#BDD1D8;fontColor=#183447;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;spacing=8;opacity=100;spacing=18;" vertex="1" parent="1">
